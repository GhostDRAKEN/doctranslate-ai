APP_NAME=DocTranslate AI
APP_ENV=development
API_PREFIX=/api

MAX_FILE_SIZE_MB=10
MAX_PAGE_COUNT=10
BATCH_SIZE_PAGES=5
ENABLE_BATCH_MODE=false
MAX_BATCH_EXPERIMENTAL_PAGES=100
STORAGE_TMP_DIR=storage/tmp

MOCK_TRANSLATION_ENABLED=false

LLM_PROVIDER=groq
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
LLM_FALLBACK_TO_MOCK=false
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1
OVERLAY_BBOX_PADDING=1.5
MIN_SEMANTIC_CONFIDENCE_OVERLAY=0.45
DEBUG_OVERLAY=false
DEBUG_SEMANTIC=false
DEBUG_OVERLAY_BBOX=false

CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001
